{
  "name": "holdings-studio-local",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "build": "node scripts/vendor.mjs && node scripts/prepare-market.mjs && node scripts/prepare-sectors.mjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "npm run test && npm run build",
    "test:browser": "node tests/browser.mjs",
    "test:ocr": "node tests/ocr-benchmark.mjs",
    "market:refresh": "node scripts/refresh-market.mjs",
    "sectors:refresh": "node scripts/refresh-sectors.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "license": "MIT"
}
